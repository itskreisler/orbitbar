{
  "schema_version": 1,
  "title": "Interactive Clock & Starfield",
  "type": "web",
  "file": "index.html",
  "description": "Functional sample wallpaper for Wallpaper Engine with dynamic properties and interactive HTML5 particle canvas",
  "author": "Orbitbar Wallpaper Engine",
  "version": "1.0.0",
  "properties": {
    "customcolor": {
      "type": "color",
      "text": "Background Base Color",
      "value": "#0f172a"
    },
    "star_count": {
      "type": "slider",
      "text": "Particle Count",
      "min": 10,
      "max": 400,
      "step": 10,
      "value": 150
    },
    "particle_speed": {
      "type": "slider",
      "text": "Particle Speed",
      "min": 0.1,
      "max": 5.0,
      "step": 0.1,
      "value": 1.0
    },
    "show_clock": {
      "type": "checkbox",
      "text": "Display Clock",
      "value": true
    },
    "clock_format": {
      "type": "combo",
      "text": "Clock Time Format",
      "visible_if": "show_clock == true",
      "value": "24h",
      "options": [
        { "label": "24 Hours (HH:MM:SS)", "value": "24h" },
        { "label": "12 Hours (AM/PM)", "value": "12h" }
      ]
    }
  }
}
